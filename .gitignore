# Ignore bundler config
/.bundle
 # Ignore vendor bundle (if used)
/vendor/bundle
# Ignore log files
/log/*
!/log/.keep

# Ignore temp files
/tmp/*
!/tmp/.keep

# Ignore storage (ActiveStorage)
/storage/*
!/storage/.keep

# Ignore uploads
/public/uploads

# Ignore credentials
/config/master.key
/config/credentials/*.key

# Ignore database files
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore node modules (if added later)
/node_modules

# Ignore environment variables
.env
.env.*

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore editor files
.vscode/
.idea/

# Ignore Ruby version manager files
.ruby-version
.ruby-gemset

# Ignore compiled files
*.o
*.so
*.dll
*.exe

# Ignore coverage reports
/coverage

# Ignore logs from tools
*.log

# Ignore pids
/tmp/pids/*
!/tmp/pids/.keep
/tmp