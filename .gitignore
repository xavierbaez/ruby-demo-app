# Ignore bundler config
/.bundle
 # Ignore vendor bundle (if used)
/vendor/bundle
# Ignore log files
log/
#Database
/db/*.sqlite3
# Ignore temp files
/tmp/*
!/tmp/.keep

# Ignore storage (ActiveStorage)
/storage/*
!/storage/.keep
vendor/
/vendor/*

# Ignore uploads
/public/uploads

# Ignore credentials
/config/master.key
/config/credentials/*.key

# Ignore database files
db/*.sqlite3
db/*.sqlite3-journal

# Ignore node modules (if added later)
/node_modules

# Ignore environment variables
.env
.env.*

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore editor files
.vscode/
.idea/

# Ignore Ruby version manager files
.ruby-version
.ruby-gemset

# Ignore compiled files
*.o
*.so
*.dll
*.exe

# Ignore coverage reports
/coverage

# Ignore logs from tools
*.log

# Ignore pids
/tmp/pids/*
!/tmp/pids/.keep
/tmp

# Rails
/public/assets
/public/packs
/public/packs-test
/node_modules
/yarn-error.log
/yarn-debug.log
/.yarn
/public/webpack

# Spring
/tmp/spring
/tmp/pids/server.pid

# Bootsnap
/tmp/bootsnap-*

# Capybara
/tmp/capybara

# === Additional recommended ignores for Rails ===

# Compiled assets and frontend packs
/public/assets
/public/packs
/public/packs-test

# Node modules and related (if you use JavaScript)
/node_modules
/yarn-error.log
/yarn-debug.log*

# Extra common temp and test files
/tmp/spring
/tmp/bootsnap-*
/tmp/capybara
/coverage

# Spring server pid
/tmp/pids/server.pid

# Byebug
.byebug_history

# Extra environment files
.env*.local

# Editor swap files
*.swp
*.swo