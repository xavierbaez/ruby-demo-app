<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container py-5">
  <div class="p-5 mb-4 bg-light rounded-4 shadow-sm">
    <h1 class="display-5 fw-bold">Apple Services Evaluation Dashboard</h1>
    <p class="lead mt-3">
      InternalApple Rails dashboard for service metrics, trend analysis, and query performance insights.
    <div class="card rounded-4 shadow-sm mt-4">
      <div class="card-body">
        <h5 class="mb-3">Service Quality Trend</h5>
        <%= line_chart @chart_data, height: "360px" %>
      </div>
    </div>
    </p>
    <div class="mt-4">
      <span class="badge bg-dark me-2">Ruby 3.4.9</span>
      <span class="badge bg-dark me-2">Rails 8.1.3</span>
      <span class="badge bg-dark me-2">SQLite now / MySQL ready</span>
      <span class="badge bg-dark me-2">Stimulus JS</span>
      <span class="badge bg-dark">Chartkick</span>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="card rounded-4 shadow-sm">
        <div class="card-body">
          <h5>Service Quality Score</h5>
          <h2>94.2%</h2>
          <p class="text-muted">Demo metric for internal evaluation.</p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card rounded-4 shadow-sm">
        <div class="card-body">
          <h5>Avg Query Time</h5>
          <h2>128ms</h2>
          <p class="text-muted">Highlights slow queries and optimization opportunities.</p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card rounded-4 shadow-sm">
        <div class="card-body">
          <h5>Optimization Status</h5>
          <h2>3 Suggestions</h2>
          <p class="text-muted">Indexing and query tuning recommendations.</p>
        </div>
      </div>
    </div>
  </div>
</div>