<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container py-5">
  <div class="p-5 mb-4 rounded-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center">
      <h1 class="display-5 fw-bold">Apple Services Evaluation Dashboard</h1>
      <button class="btn btn-outline-secondary" data-controller="theme" data-action="click->theme#toggle">
        Dark/Light Mode
      </button>
    </div>
    <p class="lead mt-3">
      Performance metrics and trend analysis across Apple Music, Apple TV+, iCloud, and Apple Arcade.
    </p>

    <div class="row g-3 mt-2">
      <div class="col-md-4">
        <div class="card rounded-4 shadow-sm text-center p-3">
          <h6 class="text-muted">Total Subscribers</h6>
          <h2 class="fw-bold"><%= @total_subscribers %></h2>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card rounded-4 shadow-sm text-center p-3">
          <h6 class="text-muted">Fastest Growing Service</h6>
          <h2 class="fw-bold"><%= @fastest_growing %></h2>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card rounded-4 shadow-sm text-center p-3">
          <h6 class="text-muted">YoY Growth</h6>
          <h2 class="fw-bold text-success"><%= @yoy_growth %></h2>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-md-6">
      <div class="card rounded-4 shadow-sm">
        <div class="card-body">
          <h5 class="mb-3">iCloud Subscribers — Last 100 Days</h5>
          <%= line_chart @icloud_trend,
                         height: "220px",
                         ytitle: "Subscribers",
                         library: {
                           backgroundColor: "transparent",
                           legend: { display: false },
                           scales: {
                             x: { ticks: { color: "#f0f0f0" }, grid: { color: "#333" } },
                             y: { ticks: { color: "#f0f0f0" }, grid: { color: "#333" } }
                           }
                         } %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card rounded-4 shadow-sm">
        <div class="card-body">
          <h5 class="mb-3">Apple Music Subscribers — Last 100 Days</h5>
          <%= line_chart @music_trend,
                         height: "220px",
                         ytitle: "Subscribers",
                         library: {
                           backgroundColor: "transparent",
                           legend: { display: false },
                           scales: {
                             x: { ticks: { color: "#f0f0f0" }, grid: { color: "#333" } },
                             y: { ticks: { color: "#f0f0f0" }, grid: { color: "#333" } }
                           }
                         } %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card rounded-4 shadow-sm">
        <div class="card-body">
          <h5 class="mb-3">Apple TV+ Subscribers — Last 100 Days</h5>
          <%= line_chart @tvplus_trend,
                         height: "220px",
                         ytitle: "Subscribers",
                         library: {
                           backgroundColor: "transparent",
                           legend: { display: false },
                           scales: {
                             x: { ticks: { color: "#f0f0f0" }, grid: { color: "#333" } },
                             y: { ticks: { color: "#f0f0f0" }, grid: { color: "#333" } }
                           }
                         } %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card rounded-4 shadow-sm">
        <div class="card-body">
          <h5 class="mb-3">Apple Arcade Subscribers — Last 100 Days</h5>
          <%= line_chart @arcade_trend,
                         height: "220px",
                         ytitle: "Subscribers",
                         library: {
                           backgroundColor: "transparent",
                           legend: { display: false },
                           scales: {
                             x: { ticks: { color: "#f0f0f0" }, grid: { color: "#333" } },
                             y: { ticks: { color: "#f0f0f0" }, grid: { color: "#333" } }
                           }
                         } %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card rounded-4 shadow-sm">
        <div class="card-body">
          <h5 class="mb-3">Subscriber Share by Service</h5>
          <%= pie_chart @subscriber_share,
                        height: "300px",
                        library: {
                          backgroundColor: "transparent",
                          plugins: {
                            legend: { labels: { color: "#f0f0f0" } }
                          }
                        } %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card rounded-4 shadow-sm">
        <div class="card-body">
          <h5 class="mb-3">Month over Month Growth %</h5>
          <%= bar_chart @monthly_growth,
                        height: "300px",
                        xtitle: "Service",
                        ytitle: "Growth %",
                        library: {
                          backgroundColor: "transparent",
                          legend: { display: false },
                          scales: {
                            x: { ticks: { color: "#f0f0f0" }, grid: { color: "#333" } },
                            y: { ticks: { color: "#f0f0f0" }, grid: { color: "#333" } }
                          }
                        } %>
        </div>
      </div>
    </div>

    <div class="col-md-12">
      <div class="card rounded-4 shadow-sm">
        <div class="card-body">
          <h5>Query Performance</h5>
          <p>Latest query executed in <strong><%= @query_time %> ms</strong></p>
          <p class="text-muted">
            Optimization suggestion: add a composite index on service_name and recorded_on for faster filtering and sorting.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4 ps-2 pb-4">
    <span class="badge bg-dark me-2">Ruby 3.4.9</span>
    <span class="badge bg-dark me-2">Rails 8.1.3</span>
    <span class="badge bg-dark me-2">SQLite now / MySQL ready</span>
    <span class="badge bg-dark me-2">Stimulus JS</span>
    <span class="badge bg-dark">Chartkick</span>
  </div>
</div>